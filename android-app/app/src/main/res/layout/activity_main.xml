<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_shield"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lütfen giriş yapın"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/permissionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="İzin Durumu:" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giriş Yap"
        android:layout_marginTop="30dp" />

    <Button
        android:id="@+id/requestPermissionsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzinleri İste" />

    <Button
        android:id="@+id/startMonitoringButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzlemeyi Başlat"
        android:enabled="false" />

    <Button
        android:id="@+id/stopMonitoringButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="İzlemeyi Durdur"
        android:enabled="false" />

</LinearLayout>
